            "text/markdown": "<span class=\"markdown prose dark:prose-invert contents\"><h2 id=\"standing-requirements\">Standing requirements</h2>\n<span class=\"paragraph\">A requirement is <strong>never closed</strong> \u2014 it is enforced for the life of the project. These bars show how much of each one currently has a build unit behind it.</span>\n<div style=\"display:flex;align-items:center;gap:10px;margin:5px 0\">\n          <code style=\"width:38px;color:#1a202c\">R1</code>\n          <div style=\"flex:1;height:9px;background:#edf2f7;border-radius:5px;overflow:hidden\">\n            <div style=\"width:100%;height:100%;\n                        background:#2f855a\"></div>\n          </div>\n          <span style=\"font-size:12px;color:#718096;width:78px\">4/4 closed</span>\n        </div>\n<div style=\"display:flex;align-items:center;gap:10px;margin:5px 0\">\n          <code style=\"width:38px;color:#1a202c\">R2</code>\n          <div style=\"flex:1;height:9px;background:#edf2f7;border-radius:5px;overflow:hidden\">\n            <div style=\"width:100%;height:100%;\n                        background:#2f855a\"></div>\n          </div>\n          <span style=\"font-size:12px;color:#718096;width:78px\">3/3 closed</span>\n        </div>\n<div style=\"display:flex;align-items:center;gap:10px;margin:5px 0\">\n          <code style=\"width:38px;color:#1a202c\">R3</code>\n          <div style=\"flex:1;height:9px;background:#edf2f7;border-radius:5px;overflow:hidden\">\n            <div style=\"width:100%;height:100%;\n                        background:#2f855a\"></div>\n          </div>\n          <span style=\"font-size:12px;color:#718096;width:78px\">3/3 closed</span>\n        </div>\n<div style=\"display:flex;align-items:center;gap:10px;margin:5px 0\">\n          <code style=\"width:38px;color:#1a202c\">R4</code>\n          <div style=\"flex:1;height:9px;background:#edf2f7;border-radius:5px;overflow:hidden\">\n            <div style=\"width:100%;height:100%;\n                        background:#2f855a\"></div>\n          </div>\n          <span style=\"font-size:12px;color:#718096;width:78px\">3/3 closed</span>\n        </div>\n<div style=\"display:flex;align-items:center;gap:10px;margin:5px 0\">\n          <code style=\"width:38px;color:#1a202c\">R5</code>\n          <div style=\"flex:1;height:9px;background:#edf2f7;border-radius:5px;overflow:hidden\">\n            <div style=\"width:100%;height:100%;\n                        background:#2f855a\"></div>\n          </div>\n          <span style=\"font-size:12px;color:#718096;width:78px\">4/4 closed</span>\n        </div>\n<div style=\"display:flex;align-items:center;gap:10px;margin:5px 0\">\n          <code style=\"width:38px;color:#1a202c\">R6</code>\n          <div style=\"flex:1;height:9px;background:#edf2f7;border-radius:5px;overflow:hidden\">\n            <div style=\"width:67%;height:100%;\n                        background:#b7791f\"></div>\n          </div>\n          <span style=\"font-size:12px;color:#718096;width:78px\">2/3 closed</span>\n        </div>\n<div style=\"display:flex;align-items:center;gap:10px;margin:5px 0\">\n          <code style=\"width:38px;color:#1a202c\">R7</code>\n          <div style=\"flex:1;height:9px;background:#edf2f7;border-radius:5px;overflow:hidden\">\n            <div style=\"width:67%;height:100%;\n                        background:#b7791f\"></div>\n          </div>\n          <span style=\"font-size:12px;color:#718096;width:78px\">2/3 closed</span>\n        </div></span>"
