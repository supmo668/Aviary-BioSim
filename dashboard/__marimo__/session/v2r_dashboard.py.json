            "text/markdown": "<span class=\"markdown prose dark:prose-invert contents\"><div style=\"display:flex;gap:12px;flex-wrap:wrap;margin-bottom:6px\">\n\n    <div style=\"flex:1;min-width:150px;padding:14px 16px;border:1px solid #e2e8f0;\n                border-radius:10px;background:#fff\">\n      <div style=\"font-size:11px;letter-spacing:.08em;text-transform:uppercase;\n                  color:#718096\">Build units</div>\n      <div style=\"font-size:30px;font-weight:650;color:#1a202c;line-height:1.15\">23</div>\n      <div style=\"font-size:12px;color:#718096\">across 7 standing requirements</div>\n    </div>\n\n    <div style=\"flex:1;min-width:150px;padding:14px 16px;border:1px solid #e2e8f0;\n                border-radius:10px;background:#fff\">\n      <div style=\"font-size:11px;letter-spacing:.08em;text-transform:uppercase;\n                  color:#718096\">Closed</div>\n      <div style=\"font-size:30px;font-weight:650;color:#2f855a;line-height:1.15\">21</div>\n      <div style=\"font-size:12px;color:#718096\">sealed test passed, committed</div>\n    </div>\n\n    <div style=\"flex:1;min-width:150px;padding:14px 16px;border:1px solid #e2e8f0;\n                border-radius:10px;background:#fff\">\n      <div style=\"font-size:11px;letter-spacing:.08em;text-transform:uppercase;\n                  color:#718096\">Parked</div>\n      <div style=\"font-size:30px;font-weight:650;color:#b7791f;line-height:1.15\">2</div>\n      <div style=\"font-size:12px;color:#718096\">attempt preserved on a branch</div>\n    </div>\n\n    <div style=\"flex:1;min-width:150px;padding:14px 16px;border:1px solid #e2e8f0;\n                border-radius:10px;background:#fff\">\n      <div style=\"font-size:11px;letter-spacing:.08em;text-transform:uppercase;\n                  color:#718096\">Drains</div>\n      <div style=\"font-size:30px;font-weight:650;color:#1a202c;line-height:1.15\">3</div>\n      <div style=\"font-size:12px;color:#718096\">each under one pinned builder