# /v2r-loop run state — must stay untracked
.v2r/
__pycache__/
.pytest_cache/
__marimo__/
science/out/

# aiadlc coordination internals — live in the private superproject, symlinked in
.claude/agents/
.claude/logs/
.claude/usr/
config/monitor-pids.json
# Workstream internals stay private. EXCEPT the v2s-bio documents, which are tracked so
# approvals pin to COMMITS rather than content hashes of untracked files (CTO #766, ruling (a)).
# qgr/ stays ignored: three receipts carry an absolute home path in a hash-covered field.
/workstreams/*
!/workstreams/v2s-bio/
/workstreams/v2s-bio/*
!/workstreams/v2s-bio/*.md
.aiadlc-agent
.aiadlc-coordinator

# white paper — local caches and LaTeX build products; evidence and PDFs are tracked
.v2r-demo/
paper/.hf-cache/
paper/*.aux
paper/*.log
paper/*.out
paper/*.fls
paper/*.fdb_latexmk
paper/*.bbl
paper/*.blg
paper/.tools/

# ISCP phase-state is local session state, not a published artifact.
.claude/workstreams/
